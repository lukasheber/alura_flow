{
  "name": "alura-flow",
  "version": "2.6.0",
  "private": true,
  "description": "Extensão do Firefox que transforma cursos da Alura em podcasts e mantém o foco.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "start": "web-ext run",
    "screenshots": "node tests/preview/screenshots.mjs",
    "live:login": "node tests/live/live-check.mjs login",
    "live:discover": "node tests/live/live-check.mjs discover",
    "live:check": "node tests/live/live-check.mjs check"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "selenium-webdriver": "^4.51.0",
    "web-ext": "^10.8.0"
  }
}
